# ── Home Assistant ─────────────────────────────
# 內網直連 HA，唔好用 domain
HA_URL=
# HA 個人 profile → Security → Long-lived access tokens → Create
HA_TOKEN=
HA_FEED_ENTITY=text.zhi_ma_guan_jia_manual_feed

# ── 餵食規則 ───────────────────────────────────
FEED_AMOUNT=10
COOLDOWN_MINUTES=120
OPEN_TIME=07:00
CLOSE_TIME=23:59
TIMEZONE=Asia/Hong_Kong

# ── 防洗版（純擋狂撳，唔係餵食額度）──────────────
# 每個 IP 每 WINDOW 秒最多可以撳幾多次 /feed
IP_MAX_HITS=5
IP_WINDOW_SECONDS=60

# ── 秘密通道（繞過冷卻／時段，淨係自己用）─────────
# 隨機長字串，用嚟喺前端簽署 /admin/feed 請求，唔好同其他密碼重複
ADMIN_TOKEN=
# 簽名時間戳容許嘅誤差秒數
ADMIN_SIG_WINDOW_SECONDS=60

# ── 網絡 ───────────────────────────────────────
# 經 Cloudflare Tunnel 入嚟，真實 IP 喺呢個 header
CLIENT_IP_HEADER=cf-connecting-ip
# 允許呢啲來源打 API（你個 SvelteKit 網域）。逗號分隔，* = 全部（測試用）
CORS_ORIGINS=*

# SQLite 檔案位置
DB_PATH=./catcam.db

# ── 餵食錄影（見 README「Feed clip recording」「Weekly highlight reel」）──
# 每次出糧錄 60 秒片，存呢個 folder，公開俾訪客睇（7 日滾動保留）
RECORDINGS_DIR=./recordings
RECORDING_SECONDS=60
RECORDING_RETENTION_DAYS=7
# 每個星期日 00:00 自動合併嗰星期精華片，存呢個 folder（私人，冇公開路由）
HIGHLIGHTS_DIR=./highlights
