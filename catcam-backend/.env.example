# ── Home Assistant ─────────────────────────────
# 內網直連 HA，唔好用 domain
HA_URL=
# HA 個人 profile → Security → Long-lived access tokens → Create
HA_TOKEN=
HA_FEED_ENTITY=text.zhi_ma_guan_jia_manual_feed

# ── 餵食規則 ───────────────────────────────────
FEED_AMOUNT=10
COOLDOWN_MINUTES=120
OPEN_TIME=07:00
CLOSE_TIME=23:59
TIMEZONE=Asia/Hong_Kong

# ── 防洗版（純擋狂撳，唔係餵食額度）──────────────
# 每個 IP 每 WINDOW 秒最多可以撳幾多次 /feed
IP_MAX_HITS=5
IP_WINDOW_SECONDS=60

# ── 秘密通道（繞過冷卻／時段，淨係自己用）─────────
# 隨機長字串，用嚟喺前端簽署 /admin/feed 請求，唔好同其他密碼重複
ADMIN_TOKEN=
# 簽名時間戳容許嘅誤差秒數
ADMIN_SIG_WINDOW_SECONDS=60

# ── 網絡 ───────────────────────────────────────
# 經 Cloudflare Tunnel 入嚟，真實 IP 喺呢個 header
CLIENT_IP_HEADER=cf-connecting-ip
# 允許呢啲來源打 API（你個 SvelteKit 網域）。逗號分隔，* = 全部（測試用）
CORS_ORIGINS=*

# SQLite 檔案位置
DB_PATH=./catcam.db

# ── 餵食錄影（見 README「Feed clip recording」「Weekly highlight reel」）──
# 每次出糧錄 60 秒片，存呢個 folder，公開俾訪客睇（7 日滾動保留）
RECORDINGS_DIR=./recordings
RECORDING_SECONDS=60
RECORDING_RETENTION_DAYS=7
# 每個星期日 00:00 自動合併嗰星期精華片，存呢個 folder（私人，冇公開路由）
HIGHLIGHTS_DIR=./highlights

# 24/7 pre-roll 環形緩衝（見 README「Pre-roll buffer」），觸發出糧時可以拼返
# 觸發前嘅畫面（唔係只有觸發後）。緩衝本身唔公開，只係錄影嘅中間產物
BUFFER_DIR=./buffer
BUFFER_SEGMENT_SECONDS=5
BUFFER_WINDOW_SECONDS=180
PRE_ROLL_SECONDS=15
POST_ROLL_SECONDS=45

# ── 串流看門狗（見 README「Stream watchdog」）────────────────
# 最新 buffer 片段超過呢個秒數冇更新 = 判定斷流（餵食掣會 disable）
STREAM_STALE_SECONDS=30
# 斷流持續幾耐先自動修復（reload PetKit + 重啟 go2rtc）
STREAM_RECOVER_AFTER_SECONDS=75
# 兩次自動修復之間最少隔幾耐，免得狂 query PetKit 雲
STREAM_RECOVER_COOLDOWN_SECONDS=300
STREAM_AUTO_RECOVER=true

# ── Telegram 通知（選填；兩個都留空 = 唔推送）────────────────
# 1) 同 @BotFather 傾「/newbot」攞 token  2) chat_id 見 README 教學
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 每次真網站訪客餵食都推一條去 Telegram（時間 + IP + 國家 + 片 URL）；
# 國家用 Cloudflare cf-ipcountry header，冇外部 geo-IP。片連結用呢個 base
NOTIFY_VISITOR_FEEDS=true
# CatCam 自動餵食完成錄影後推送（自動餵食 + 時間 + 片 URL，冇 IP）
NOTIFY_AUTO_FEEDS=true
# 公開餵食時段內，最新 feed_event 超過指定小時後提醒一次；公開時間外的
# 自動餵食／其他真實餵食同樣會重設計時
FEED_INACTIVITY_ALERT_ENABLED=true
FEED_INACTIVITY_ALERT_HOURS=5
PUBLIC_BASE_URL=https://cat.kelvinp.work
